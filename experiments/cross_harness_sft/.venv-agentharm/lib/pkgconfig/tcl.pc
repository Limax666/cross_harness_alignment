# tcl pkg-config source file

prefix=/root/cross_harness_aligement/experiments/cross_harness_sft/.venv-agentharm
exec_prefix=/root/cross_harness_aligement/experiments/cross_harness_sft/.venv-agentharm
libdir=/root/cross_harness_aligement/experiments/cross_harness_sft/.venv-agentharm/lib
