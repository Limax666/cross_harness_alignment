+def response_format_rejected(error):
+    """Fallback only for an explicitly unsupported JSON response format."""
+    text = str(error).lower()
+    return getattr(error, "status_code", None) in (400, 422) and "response_format" in text and any(
+        word in text for word in ("unsupported", "not supported", "unknown", "not allowed")
+    )
+
+
+def is_billing_error(error):
+    return getattr(error, "status_code", None) == 402 or "insufficient_balance" in str(error).lower()
+
+
+def billing_guard_path():
+    return Path(os.environ.get("HARNESSRISK_JUDGE_BILLING_GUARD",
+        str(Path.home() / ".cache/harnessrisk-judge/billing-blocked.json")))
+
+
+def billing_block_state():
+    state = load_json(billing_guard_path(), {}) or {}
+    return state if state.get("retry_after", 0) > time.time() else None
+
+
+def mark_billing_block(case_id):
+    path = billing_guard_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    state = {"reason": "provider_402_insufficient_balance", "case_id": case_id,
+             "at": time.time(), "retry_after": time.time() + 3600,
+             "recovery": "Retry only incomplete cases after quota recovery; keep completed results and evidence"}
+    temporary = path.with_name(path.name + "." + str(os.getpid()) + ".tmp")
+    temporary.write_text(json.dumps(state, indent=2) + "\n")
+    temporary.chmod(0o600)
+    os.replace(temporary, path)
+    return state
 
 
