+def _track_generation_task(func):
+    """Track server-side RPCs, including time before vLLM registers a request."""
+    import functools
+    @functools.wraps(func)
+    async def wrapped(self, *args, **kwargs):
+        request_id = kwargs.get('request_id', args[2] if len(args) > 2 else None)
+        if not request_id:
+            raise ValueError('generation request_id is required')
+        tasks = getattr(self, '_generation_tasks', None)
+        if tasks is None:
+            tasks = self._generation_tasks = {}
+        if request_id in tasks:
+            raise ValueError('duplicate active generation request_id')
+        task = asyncio.current_task()
+        tasks[request_id] = task
+        try:
+            return await func(self, *args, **kwargs)
+        finally:
+            if tasks.get(request_id) is task:
+                tasks.pop(request_id, None)
+    return wrapped
+
