+def park_fsdp_optimizer_states_for_sync(optimizer):
+    """Back CPU Adam states with reclaimable files during colocated weight sync.
+
+    Project-local patch (cross_harness_alignment): the colocated weight-sync
+    path overlaps optimizer-offload anonymous pages with vLLM wake-up and FSDP
+    state-dict collection, a ~90GB transient host-RAM spike that OOM-killed
+    r18/r19. Parking the states on unlinked file mappings makes those pages
+    reclaimable for the sync window.
+
+    The state values remain ordinary CPU tensors to the optimizer.  Each file is
+    unlinked after its mapping is populated, so an interrupted worker cannot
+    leave multi-GB optimizer snapshots in /tmp.  The next optimizer load copies
+    these tensors back to the GPU through ``load_fsdp_optimizer`` as usual.
+    """
+    import ctypes
+    import gc
+    import tempfile
+
+    parked_bytes = 0
+    libc = ctypes.CDLL(None, use_errno=True)
+    for group in optimizer.param_groups:
+        for param in group["params"]:
+            for key, value in optimizer.state[param].items():
+                if not isinstance(value, torch.Tensor) or value.device.type != "cpu" or value.nbytes < 1 << 20:
+                    continue
+                fd, path = tempfile.mkstemp(
+                    prefix="verl-optimizer-sync-", dir=os.environ.get("VERL_SYNC_PARK_DIR", "/tmp")
+                )
+                try:
+                    os.ftruncate(fd, value.nbytes)
+                    mapped = torch.from_file(path, shared=True, size=value.numel(), dtype=value.dtype).view(value.shape)
+                    mapped.copy_(value)
+                    os.fsync(fd)
+                    # A clean file mapping still contributes to RSS until its
+                    # pages are evicted. Drop them now; later reads fault the
+                    # exact state values back from the backing inode.
+                    if libc.madvise(ctypes.c_void_p(mapped.data_ptr()), ctypes.c_size_t(value.nbytes), 4) != 0:
+                        raise OSError(ctypes.get_errno(), "madvise(MADV_DONTNEED) failed")
+                    optimizer.state[param][key] = mapped
+                    parked_bytes += value.nbytes
+                finally:
+                    os.close(fd)
+                    os.unlink(path)
