+"""Opt-in settings for memory-bounded reference log-prob computation."""
+
+import os
+from dataclasses import replace
+
+
+def reference_fused_model_config(model_config):
+    options = dict(model_config.fused_kernel_options or {})
+    options["impl_backend"] = "torch"
+    return replace(model_config, use_fused_kernels=True, fused_kernel_options=options)
+
+
+def reference_chunk_size():
+    value = int(os.environ.get("VERL_REF_FUSED_CHUNK_SIZE", "512"))
+    if value <= 0:
+        raise ValueError("VERL_REF_FUSED_CHUNK_SIZE must be positive")
+    return value
