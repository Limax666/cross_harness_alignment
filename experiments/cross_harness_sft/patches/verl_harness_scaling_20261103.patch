@@ -0,0 +1,55 @@
+"""Helpers for preparing sharded actor weights for rollout backends."""
+
+from __future__ import annotations
+
+import os
+
+import torch
+
+
+_SYNC_DTYPES = {
+    "bf16": torch.bfloat16,
+    "bfloat16": torch.bfloat16,
+    "fp16": torch.float16,
+    "float16": torch.float16,
+    "fp32": torch.float32,
+    "float32": torch.float32,
+}
+
+
+def rollout_sync_dtype() -> torch.dtype | None:
+    """Return an explicitly configured rollout transfer dtype, or None.
+
+    The default preserves VeRL's historical transfer behavior. Setting this
+    only changes the temporary synchronization representation; it never casts
+    or mutates the trainable parameters or optimizer state.
+    """
+    value = os.environ.get("VERL_SYNC_WEIGHT_DTYPE")
+    if value is None or not value.strip():
+        return None
+    try:
+        return _SYNC_DTYPES[value.strip().lower()]
+    except KeyError as exc:
+        raise ValueError(
+            f"Unsupported VERL_SYNC_WEIGHT_DTYPE={value!r}; choose bf16, fp16, or fp32"
+        ) from exc
+
+
+def materialize_rollout_weight(param, device: torch.device, dtype: torch.dtype | None):
+    """Stage a sharded tensor, cast its local shard, then gather if needed.
+
+    Casting before ``full_tensor`` bounds the temporary GPU allocation by the
+    rollout dtype. This is particularly useful when FP32 master parameters are
+    transferred to a BF16 rollout engine. The source parameter remains intact.
+    """
+    # FSDP2 CPUOffloadPolicy keeps the local master shard on CPU. Cast there
+    # first: moving an FP32 shard to an already crowded GPU and then allocating
+    # its BF16 copy can itself OOM before the lower-precision all-gather begins.
+    staged = param
+    if dtype is not None and staged.is_floating_point() and staged.dtype != dtype:
+        staged = staged.to(dtype=dtype)
+    staged = staged.to(device, non_blocking=True)
+
+    from torch.distributed.tensor import DTensor
+
+    return staged.full_tensor() if isinstance(staged, DTensor) else staged
