index 00000000..c23c1f20
--- /dev/null
+++ b/verl/utils/scaled_chunked_outputs.py
@@ -0,0 +1,50 @@
+"""Temperature-scaled selected log-probs and entropy without mutating logits."""
+
+import torch
+
+
+class _ScaledChunkedOutputs(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, logits, labels, temperatures, chunk_size):
+        if logits.ndim != 2 or labels.shape != logits.shape[:-1] or temperatures.shape != labels.shape:
+            raise ValueError("expected logits [tokens,vocab] and matching labels/temperatures")
+        if chunk_size <= 0:
+            raise ValueError("chunk_size must be positive")
+        temps = temperatures.clamp(min=1e-8).to(logits.dtype)
+        selected, entropies = [], []
+        for start in range(0, logits.shape[0], chunk_size):
+            stop = min(start + chunk_size, logits.shape[0])
+            scores = (logits[start:stop] / temps[start:stop, None]).float()
+            logsum = torch.logsumexp(scores, dim=-1)
+            probs = scores.softmax(dim=-1)
+            selected.append(scores.gather(-1, labels[start:stop, None]).squeeze(-1) - logsum)
+            entropies.append(logsum - (probs * scores).sum(-1))
+        ctx.save_for_backward(logits, labels, temps)
+        ctx.chunk_size = chunk_size
+        ctx.set_materialize_grads(False)
+        return torch.cat(selected), torch.cat(entropies)
+
+    @staticmethod
+    def backward(ctx, grad_logp, grad_entropy):
+        logits, labels, temps = ctx.saved_tensors
+        grad_logits = torch.empty_like(logits)
+        for start in range(0, logits.shape[0], ctx.chunk_size):
+            stop = min(start + ctx.chunk_size, logits.shape[0])
+            scores = (logits[start:stop] / temps[start:stop, None]).float()
+            logsum = torch.logsumexp(scores, dim=-1, keepdim=True)
+            log_probs = scores - logsum
+            probs = log_probs.exp()
+            grad = torch.zeros_like(probs)
+            if grad_logp is not None:
+                g = grad_logp[start:stop, None].float()
+                grad = -probs * g
+                grad.scatter_add_(-1, labels[start:stop, None], g)
+            if grad_entropy is not None:
+                entropy = -(probs * log_probs).sum(-1, keepdim=True)
+                grad = grad - grad_entropy[start:stop, None].float() * probs * (log_probs + entropy)
+            grad_logits[start:stop].copy_(grad / temps[start:stop, None].float())
+        return grad_logits, None, None, None
+
+
+def scaled_chunked_logprobs_entropy(logits, labels, temperatures, chunk_size=128):
+    return _ScaledChunkedOutputs.apply(logits, labels, temperatures, chunk_size)
