+class _ChunkedSelectedLogProb(torch.autograd.Function):
+    """Selected log-probabilities without retaining a full float32 vocab tensor.
+
+    The ordinary bfloat16 fallback casts every token's vocabulary logits to
+    float32 for ``logsumexp``. Autograd then retains that cast until backward,
+    which can exhaust a 24 GiB card on long online-agent trajectories. Keep
+    only the original logits and recompute the softmax in small token chunks
+    during backward. The gradient is exactly one_hot(label) - softmax(logits).
+    """
+
+    @staticmethod
+    def forward(ctx, logits: torch.Tensor, labels: torch.Tensor) -> torch.Tensor:
+        original_shape = labels.shape
+        vocab_size = logits.shape[-1]
+        flat_logits = logits.reshape(-1, vocab_size)
+        flat_labels = labels.reshape(-1)
+        chunk_size = 32
+        selected = []
+        for start in range(0, flat_logits.shape[0], chunk_size):
+            chunk = flat_logits[start : start + chunk_size].float()
+            targets = flat_labels[start : start + chunk_size].unsqueeze(-1)
+            selected.append(chunk.gather(-1, targets).squeeze(-1) - torch.logsumexp(chunk, dim=-1))
+        ctx.save_for_backward(logits, labels)
+        ctx.chunk_size = chunk_size
+        return torch.cat(selected).reshape(original_shape)
+
+    @staticmethod
+    def backward(ctx, grad_output: torch.Tensor) -> tuple[torch.Tensor, None]:
+        logits, labels = ctx.saved_tensors
+        vocab_size = logits.shape[-1]
+        flat_logits = logits.reshape(-1, vocab_size)
+        flat_labels = labels.reshape(-1)
+        flat_grad = grad_output.reshape(-1)
+        grad_logits = torch.empty_like(flat_logits)
+        for start in range(0, flat_logits.shape[0], ctx.chunk_size):
+            stop = start + ctx.chunk_size
+            grad = -torch.softmax(flat_logits[start:stop].float(), dim=-1)
+            grad.scatter_add_(
+                -1,
+                flat_labels[start:stop].unsqueeze(-1),
+                torch.ones_like(flat_grad[start:stop]).unsqueeze(-1),
+            )
+            grad.mul_(flat_grad[start:stop].unsqueeze(-1))
+            grad_logits[start:stop].copy_(grad)
+        return grad_logits.reshape(logits.shape), None
+
