+def flashrsi_nested_tool_events(transcripts, max_text_chars):
+    """Expose recorded native events, without inventing actions or changing archives."""
+    events = []
+    starts = {"tool_start", "tool_execution_start"}
+    ends = {"tool_end", "tool_execution_end"}
+    for row in transcripts:
