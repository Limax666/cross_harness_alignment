+            if not isinstance(raw, dict) or raw.get("type") not in starts | ends:
+                continue
+            event = {
+                "source": "flashrsi_native_tool_call" if raw["type"] in starts else "flashrsi_native_tool_result",
+                "line": row.get("_line") or row.get("line"),
+                "source_file": row.get("source"),
+                "owner_turn": entry.get("owner_turn"),
+                "event_index": index,
+                "call_id": raw.get("id"),
+                "tool": raw.get("name"),
+                "source_event_sha256": hashlib.sha256(json.dumps(raw, ensure_ascii=False, sort_keys=True).encode()).hexdigest(),
+            }
+            if raw["type"] in starts:
+                event["arguments"] = truncate(raw.get("arguments", {}), max_text_chars)
+            else:
+                result = raw.get("result", "")
+                event["content"] = truncate(result, max_text_chars)
+                details = result
+                if isinstance(result, str):
+                    try:
+                        details = json.loads(result)
+                    except (ValueError, TypeError):
+                        details = {}
+                event["is_error"] = (
+                    details.get("ok") is False
+                    or details.get("returncode", details.get("exit_code")) not in (None, 0)
+                    or bool(details.get("error"))
+                ) if isinstance(details, dict) else None
+            events.append(event)
+    return events
+
