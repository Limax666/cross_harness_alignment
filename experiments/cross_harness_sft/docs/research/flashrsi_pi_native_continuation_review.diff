+    receipt = terminal_receipt(retained())
+    assert receipt['kind'] == 'native_max_turns'
+    assert receipt['model_calls'] == 12 and receipt['tool_calls'] == 12
+    assert receipt['native_status'] == 'error'
+    assert retained()['output'] == ''
